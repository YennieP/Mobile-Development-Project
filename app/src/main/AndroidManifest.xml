<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to dial phone calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NUMAD26SP_YanxiPan"
        tools:targetApi="31">

        <!-- About Me Activity -->
        <activity
            android:name=".AboutMeActivity"
            android:exported="false"
            android:theme="@style/Theme.NUMAD26SP_YanxiPan" />

        <!-- Prime Directive Activity -->
        <activity
            android:name=".PrimeActivity"
            android:exported="false"
            android:theme="@style/Theme.NUMAD26SP_YanxiPan" />

        <!-- QuicCalc Activity -->
        <activity
            android:name=".QuicCalcActivity"
            android:exported="false"
            android:theme="@style/Theme.NUMAD26SP_YanxiPan" />

        <!-- Contacts Collector Activity -->
        <activity
            android:name=".ContactsActivity"
            android:exported="false"
            android:theme="@style/Theme.NUMAD26SP_YanxiPan" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NUMAD26SP_YanxiPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--  Location Activity  -->
        <activity android:name=".LocationActivity" android:exported="false" />


    </application>

</manifest>